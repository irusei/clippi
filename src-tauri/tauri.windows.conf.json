{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "clippi",
    "version": "0.1.0",
    "identifier": "com.iru.clippi",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "bundle": {
        "active": true,
        "targets": "nsis",
        "windows": {
            "nsis": {
                "installerHooks": "../hook.nsh"
            }
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": ["installer.exe", "assets/bookmark.wav"]
    },
    "app": {
        "windows": [
            {
                "title": "clippi",
                "width": 1650,
                "height": 1060,
                "maximizable": true,
                "resizable": true
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["**"]
            }
        }
    }
}
